# Copy this file to .env.local and add your Resend API key.
RESEND_API_KEY=re_your_api_key
# Add multiple recipients separated by commas.
BUSINESS_REQUEST_TO_EMAIL=your-inbox@example.com,second-inbox@example.com

# For Resend testing only. Production requires a sender on a verified domain.
BUSINESS_REQUEST_FROM_EMAIL="Testado <onboarding@resend.dev>"