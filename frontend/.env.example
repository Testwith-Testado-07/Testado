# Copy this file to .env.local and add your Resend API key.
RESEND_API_KEY=re_your_api_key
# Shared recipients for business enquiries and tester applications.
# Add multiple recipients separated by commas.
BUSINESS_REQUEST_TO_EMAIL=your-inbox@example.com,second-inbox@example.com

# For Resend testing only. Production requires a sender on a verified domain.
# Shared sender for business enquiries and tester applications.
BUSINESS_REQUEST_FROM_EMAIL="Testado <onboarding@resend.dev>"

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# EmailJS configuration
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_bl8rqgo
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
NEXT_PUBLIC_EMAILJS_WELCOME_TEMPLATE_ID=your_welcome_template_id
NEXT_PUBLIC_EMAILJS_BUSINESS_TEMPLATE_ID=your_business_template_id
NEXT_PUBLIC_EMAILJS_TESTER_TEMPLATE_ID=your_tester_template_id
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id